# .dockerignore - what never goes into a Docker image

# Secrets (the containers read .env at runtime through docker-compose)
.env
.env.*

# Caches, local tools and git
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.git/
.github/
.claude/

# Built inside the image instead, or mounted at runtime
web/node_modules/
web/dist/
data/
legacy/
