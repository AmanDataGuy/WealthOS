# .env.example - copy to .env and fill in. Only the first block is required.
# Check your setup any time with: python scripts/verify_env.py

# ── Required: a language model (the assistant, AI dashboard edits, strategy parsing) ─────────
# Groq is the primary provider; OpenRouter is the fallback when Groq fails or is rate-limited.
GROQ_API_KEY=your_groq_key
OPENROUTER_API_KEY=sk-or-...
# Optional model overrides (defaults shown)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free   # any OpenRouter ":free" model costs nothing
# Stop calling the LLM for the day after this much spend (USD); dashboards and metrics keep working.
# WEALTHOS_MAX_DAILY_COST_USD=5.0
# WEALTHOS_MAX_DAILY_COST_USD_USER=0.50
# Comma-separated proxy IPs whose X-Forwarded-For is trusted for per-IP rate limits (e.g. the Caddy container)
# WEALTHOS_TRUSTED_PROXIES=
# NSE price downloads: on by default outside production, off in production (licensing) unless set to 1
# WEALTHOS_ENABLE_NSE=
# A ":free" LLM_FALLBACK_MODEL is skipped in production unless set to 1 (free endpoints may keep prompts)
# WEALTHOS_ALLOW_FREE_FALLBACK=
# Python strategy uploads (strategy lab): on outside production, off in production unless set to 1
# WEALTHOS_ENABLE_PY_STRATEGIES=

# ── Sign-in (Postgres holds the users table and the LLM cost log) ────────────────────────────
# docker compose up -d wealthos-db  starts Postgres with this password (compose reads it from .env).
POSTGRES_PASSWORD=change_me
# Must use the same password as above when the API runs outside compose.
WEALTHOS_DB_URL=postgresql://wealthos:change_me@localhost:5432/wealthos
# Signs session tokens: required, 32+ bytes. The API refuses to start without one.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEALTHOS_JWT_SECRET=
# dev | test | production. Unset means production. docker-compose runs production.
WEALTHOS_ENV=dev
# Local only: WEALTHOS_ENV=dev + this = skip sign-in checks entirely (never use on a shared machine)
# WEALTHOS_DEV_INSECURE_AUTH=1
# Create one demo-<random> account at startup; its password is printed once to the API log
# WEALTHOS_DEMO_SEED=1
# Sign-in token lifetime in days
# WEALTHOS_TOKEN_DAYS=7
# Browser origins allowed to call the API (the Vite dev server proxies, so only needed for other hosts)
# ALLOWED_ORIGINS=http://localhost:5173

# ── SEC filings (US company figures in the assistant) ───────────────────────────────────────
# SEC asks every client to identify itself with a name and contact email.
SEC_USER_AGENT=WealthOS your-email@example.com

# ── Strategy lab ────────────────────────────────────────────────────────────────────────────
# Yearly risk-free rate for the Sharpe ratio (INR, roughly the 91-day T-bill)
# WEALTHOS_RISK_FREE_RATE=0.065
# Results on periods before this date get a "the AI may already know what happened" warning
# LLM_KNOWLEDGE_CUTOFF=2024-12-31

# ── Tracing (optional): with both keys set, each assistant question is one Langfuse trace ────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Excel templates (excel.py): only if LibreOffice is not in the default install folder ─────
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
