# .env.example - copy to .env and fill in. Only the first block is required.
# Check your setup any time with: python scripts/verify_env.py

# ── Required: a language model (the assistant, AI dashboard edits, strategy parsing) ─────────
# Groq is the primary provider; OpenRouter is the fallback when Groq fails or is rate-limited.
GROQ_API_KEY=your_groq_key
OPENROUTER_API_KEY=sk-or-...
# Optional model overrides (defaults shown)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL_FAST=openai/gpt-oss-20b
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free   # any OpenRouter ":free" model costs nothing
# Stop calling the LLM for the day after this much spend (USD); dashboards and metrics keep working.
# WEALTHOS_MAX_DAILY_COST_USD=5.0

# ── Sign-in (Postgres holds the users table and the LLM cost log) ────────────────────────────
# docker compose up -d wealthos-db  starts it with these credentials.
WEALTHOS_DB_URL=postgresql://wealthos:wealthos_secure_password@localhost:5432/wealthos
# Signs session tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Unset = no auth check (local development only).
WEALTHOS_JWT_SECRET=...
# production = refuse to run without WEALTHOS_JWT_SECRET instead of skipping auth
# WEALTHOS_ENV=production
# Browser origins allowed to call the API (the Vite dev server proxies, so only needed for other hosts)
# ALLOWED_ORIGINS=http://localhost:5173

# ── Database connections (connect Postgres / MySQL / SQLite to a workspace) ──────────────────
# Encrypts saved connection strings. Changing it makes saved connections unreadable (connect again).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEALTHOS_FERNET_KEY=...

# ── SEC filings (US company figures in the assistant) ───────────────────────────────────────
# SEC asks every client to identify itself with a name and contact email.
SEC_USER_AGENT=WealthOS your-email@example.com

# ── Strategy lab ────────────────────────────────────────────────────────────────────────────
# Yearly risk-free rate for the Sharpe ratio (INR, roughly the 91-day T-bill)
# WEALTHOS_RISK_FREE_RATE=0.065
# Results on periods before this date get a "the AI may already know what happened" warning
# LLM_KNOWLEDGE_CUTOFF=2024-12-31

# ── Excel templates (excel.py): only if LibreOffice is not in the default install folder ─────
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
