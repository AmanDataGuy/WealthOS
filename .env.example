# WealthOS — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.
#
# Required keys are marked [REQUIRED]. Everything else has a working default.

# ── Database ──────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string. Vector search is Qdrant, not
# pgvector — this Postgres instance holds structured data only (transactions,
# holdings, users, etc.).
# Used by: all 8 agents, finance MCP server (merged portfolio+calculator),
# RAG indexer's indexed_tickers tracking, rebalancing agent.
# docker-compose default: postgresql://wealthos:wealthos_secure_password@localhost:5432/wealthos
WEALTHOS_DB_URL=postgresql://wealthos:wealthos_secure_password@localhost:5432/wealthos

# ── Cache ─────────────────────────────────────────────────────────────────────

# Redis connection string.
# Used by: api/main.py (analysis cache), data_agent.py, market/news/sec_edgar MCP servers.
# Default connects to local Redis on the standard port.
REDIS_URL=redis://localhost:6379

# ── LLM Providers ─────────────────────────────────────────────────────────────

# [REQUIRED] Groq API key — primary LLM provider (openai/gpt-oss-120b).
# Used by: risk_agent, writer_agent, code_agent, llm_client (primary in fallback chain),
#          eval/evaluate.py (LLM-as-judge), weave_config.py (memo scorer).
# Get key: https://console.groq.com
GROQ_API_KEY=your_primary_key
GROQ_API_KEY_2=optional_second_key
GROQ_API_KEY_3=optional_third_key

# OLLAMA_URL — removed. Ollama is no longer used by any agent.
# All local LLM calls have been removed; Groq is the only LLM provider.

# [OPTIONAL] Google Gemini API key — not currently used by any agent or eval
# script (the DeepEval CI gate uses GROQ_API_KEY, not Gemini). Documented here
# only as a placeholder for future long-context doc analysis work.
# Get key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=your_gemini_key_here
GOOGLE_API_KEY=your_gemini_key_here

# [RECOMMENDED] OpenRouter API key — real Groq fallback provider.
# Used by: services/llm_client.py (call_llm) — tried automatically if every
# configured Groq key fails, using the free openai/gpt-oss-20b:free model.
# Optional but meaningfully reduces the single-provider risk Groq's own
# 2026-08-19 model retirement demonstrated (broke every agent call with no
# fallback in place at the time).
# Get key: https://openrouter.ai → Keys → Create Key
OPENROUTER_API_KEY=sk-or-...

# [NOT IMPLEMENTED] Anthropic API key — was intended for PDF/image understanding
# (input/pdf_processor.py, input/vision_handler.py), but neither file exists in
# the current tree. Setting this does nothing.
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# [NOT IMPLEMENTED] OpenAI API key — was intended for Whisper speech-to-text
# (input/whisper_handler.py), which doesn't exist in the current tree.
# Setting this does nothing.
# Get key: https://platform.openai.com
OPENAI_API_KEY=sk-...

# ── Memory ────────────────────────────────────────────────────────────────────

# [REQUIRED for cross-session memory] Mem0 cloud API key.
# Used by: memory/mem0_client.py — reads user financial memory at pipeline start,
#          writes updated memory at pipeline end (writer_node in graph/nodes.py).
# Get key: https://app.mem0.ai
MEM0_API_KEY=m0-...

# ── MCP Servers / External Data APIs ─────────────────────────────────────────

# Base URL for the WealthOS finance MCP server (finance_server.py).
# Used by: agents/finance_agent.py to fetch personal finance data.
# Change if running MCP servers on a different host/port.
FINANCE_MCP_URL=http://localhost:8001

# NewsAPI.org key — used for financial news headlines and sentiment.
# Used by: mcp_servers/news_server.py (search_news, get_headlines, get_sentiment),
#          agents/research_agent.py.
# Get key: https://newsapi.org  (free tier: 100 req/day)
NEWSAPI_KEY=...

# Firecrawl API key — used for Reddit sentiment scraping (r/investing, r/stocks)
# and earnings call transcript discovery/indexing (fool.com).
# Used by: mcp_servers/news_server.py (get_reddit_sentiment), rag/earnings_indexer.py.
# Optional — both features return a graceful warning/skip if this is absent.
# Get key: https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# SEC EDGAR User-Agent string — required by SEC to identify your application.
# Used by: mcp_servers/sec_edgar_server.py, rag/pipeline.py.
# Format: "AppName contact@email.com" — use your real email or SEC may rate-limit you.
SEC_USER_AGENT=WealthOS research@wealthos.app

# [REQUIRED for code sandbox] E2B cloud sandbox API key.
# Used by: agents/code_agent.py — runs DCF, Monte Carlo, sensitivity analysis
#          in an isolated Python sandbox. Pipeline degrades gracefully if absent.
# Get key: https://e2b.dev
E2B_API_KEY=e2b_...

# ── Observability ─────────────────────────────────────────────────────────────

# LangSmith API key — traces the full LangGraph pipeline waterfall.
# Used by: observability/langsmith_config.py (trace_node, trace_agent, verify_langsmith).
# All tracing is silently disabled if absent.
# Get key: https://smith.langchain.com
LANGCHAIN_API_KEY=ls__...

# Enable LangSmith tracing (must be "true" for traces to be captured).
# Used by: the LangSmith SDK reads this env var directly.
LANGCHAIN_TRACING_V2=true

# LangSmith project name — organises traces in the UI.
# Used by: observability/langsmith_config.py
LANGCHAIN_PROJECT=WealthOS

# Weights & Biases API key — used for eval result logging via W&B Weave.
# Used by: observability/weave_config.py (log_eval_result), eval/evaluate.py.
# All W&B logging is silently disabled if absent.
# Get key: https://wandb.ai
WANDB_API_KEY=...

# ── RAG / Vector Store ────────────────────────────────────────────────────────

# [REQUIRED for RAG] Qdrant Cloud cluster URL.
# Used by: rag/indexer.py, rag/query_engine.py — hybrid dense+sparse search.
# Get a free 1 GB cluster at https://cloud.qdrant.io (no credit card needed).
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333

# [REQUIRED for RAG] Qdrant Cloud API key for the cluster above.
# Found in the Qdrant Cloud dashboard → cluster → API Keys.
QDRANT_API_KEY=...

# VOYAGE_API_KEY — no longer required. Dense embeddings now use
# sentence-transformers/all-MiniLM-L6-v2 (384-dim, local CPU, no API key needed).
# VOYAGE_API_KEY=pa-...  (unused)

# [REQUIRED for RAG reranking] Cohere API key — rerank-english-v3.0.
# Used by: rag/query_engine.py — re-orders top-20 hybrid hits to top-5.
# Free trial available at https://dashboard.cohere.com
COHERE_API_KEY=...

# ── Application ───────────────────────────────────────────────────────────────

# CORS allowed origins for the FastAPI backend, comma-separated.
# Used by: api/main.py (CORSMiddleware).
# Add your production frontend URL here before deploying.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# [RECOMMENDED — was undocumented here] API key required on POST /analyze and
# /analyze/stream. Used by: api/main.py (verify_api_key). If unset, those two
# endpoints are open to anyone.
WEALTHOS_API_KEY=...

# Max /analyze requests per user per 60s window (Redis sliding-window log).
# Used by: api/main.py (_check_rate_limit). Default: 10.
ANALYZE_RATE_LIMIT=10

# [RECOMMENDED] Secret used to sign/verify JWTs issued at /auth/login and
# /auth/signup. Used by: api/main.py (verify_user_token) to protect every
# {user_id}-scoped endpoint (/history, /portfolio, /memory incl. DELETE,
# /user-profile, /user-analyses) — without it, any caller
# can read/delete any user's data just by putting their user_id in the URL.
# If unset, these endpoints fall back to open (matches WEALTHOS_API_KEY's
# fail-open pattern) so a bare local checkout still runs with no extra setup.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
WEALTHOS_JWT_SECRET=...

# [RECOMMENDED for real deployments] Set to "production" to make a missing
# WEALTHOS_JWT_SECRET or WEALTHOS_API_KEY refuse requests (500) instead of
# silently running with auth/rate-limiting wide open. Leave unset for local
# dev — default behavior (fail-open) is unchanged.
WEALTHOS_ENV=production
