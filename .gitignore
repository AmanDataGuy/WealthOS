# .gitignore - what never goes into git

# Secrets: only the example is committed
.env
.env.*
!.env.example

# Python and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
venv/

# Web app: installed packages and build output
node_modules/
frontend/dist/

# Your data, downloads and backups (personal financial data, never committed)
backend/storage/

# Local editor / OS / assistant files
.vscode/
.claude/
.DS_Store
Thumbs.db
*.log
